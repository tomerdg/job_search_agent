# Copy to .env (git-ignored) for local runs. GitHub Actions uses repository secrets instead.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: email (Gmail needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com

# Optional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
